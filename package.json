{
  "name": "sio-desktop",
  "productName": "SIO",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Lokale Fallkoordination und Fristen\u00fcbersicht",
  "author": "SIO",
  "license": "UNLICENSED",
  "scripts": {
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "pack": "npm run build && electron-builder --win --x64 --dir --publish never",
    "test:ui": "vitest run",
    "release": "npm run build && electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.468.0",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "de.sio.desktop",
    "productName": "SIO",
    "directories": {
      "output": "release-sio-0.3.0"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json",
      "assets/**/*"
    ],
    "asar": true,
    "win": {
      "icon": "assets/SIO_Logo.ico",
      "signExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "SIO-Setup-${version}-${arch}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "SIO-${version}-portable-${arch}.${ext}"
    }
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hubertoink/SIO.git"
  }
}
